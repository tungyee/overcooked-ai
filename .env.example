# Overcooked! 2 AI 陪玩 —— 语音对话配置示例
#
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，禁止提交。
# 本文件只列变量名和占位符，不含任何密钥。
#
# run_agent.py 启动时会自动读取仓库根 .env（已有环境变量优先）；
# 也可用 --env-file PATH 指定文件，或 --no-env-file 关闭。
# 需要手动导出到当前 shell 时：
#   set -a; . ./.env; set +a
#
# 只填这一段也能跑：不设 OC2_VOICE 时，必需 key 齐全才自动开语音；
# 缺 key 会告警并退回无语音模式；显式 `--voice` 则缺 key 直接报错。
# 语音依赖先装：pip3 install -r requirements-voice.txt

# ---- 火山引擎「大模型流式语音识别」ASR ----
# 控制台：https://console.volcengine.com/speech/service/16
VOLC_ASR_API_KEY=your-volc-asr-api-key
# 默认 volc.seedasr.sauc.duration（2.0 小时版，推荐）
# 1.0 是 volc.bigasr.sauc.duration，需要账号单独开通对应资源
# VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ---- 火山引擎流式语音合成 TTS ----
# 控制台：https://console.volcengine.com/speech/service/8
VOLC_TTS_API_KEY=your-volc-tts-api-key
# 默认 zh_female_vv_uranus_bigtts（Vivi，2.0 音色，匹配 seed-tts-2.0）
# 注意：1.0 音色（如 zh_female_qingxin）与 2.0 资源不匹配，会报 55000000
# VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
# 默认 seed-tts-2.0
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0

# ---- 火山方舟 LLM（OpenAI 兼容接口）----
# 控制台：https://console.volcengine.com/ark
ARK_API_KEY=your-ark-api-key
# 必填：方舟控制台创建的推理接入点 ID 或模型名；推荐快模型
# 客户端固定传 thinking.type=disabled，带「深度思考」标签的模型也会关闭思考
# 例如：doubao-seed-2-1-lite-260915 / doubao-seed-2-1-turbo-260628
ARK_MODEL=your-endpoint-id
# 默认 https://ark.cn-beijing.volces.com/api/v3
# 方舟「兼容 OpenAI 接口协议工具」/ plan 套餐的 key 使用：
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# ---- 对话层本机配置（都有默认值）----
# 0 强制关；其他值表示希望开（缺必需 key 时仍告警并退回无语音）
# 显式 --voice 优先于 OC2_VOICE=0
# OC2_VOICE=1
# 允许范围 0.5–2.0；非有限值回退默认，超范围收敛到边界
OC2_VOICE_RATE=1.05
# 允许范围 0.0–1.5；非有限值回退默认，超范围收敛到边界
OC2_VOICE_VOLUME=0.7
# VAD 开口阈值（底噪之上的 dB）；越小越敏感。默认 9；安静环境/小声说话可试 4–6
OC2_VOICE_VAD_DB=9
# PTT：按住该键录音、松开发送，不再用 VAD 自动切句；留空则继续用 VAD。
# 笔记本 F8 默认是媒体键，需要 Fn+F8 或启用「标准功能键」。
# 手柄可用 Steam Input 映射；run_game.sh 直接启动时 Steam 游戏布局可能不生效。
# OC2_VOICE_PTT_KEY=f8
# Windows 建议按住 Caps Lock 录音、松开发送；Alt/Ctrl/Shift 可能与游戏快捷键冲突，
# 笔记本 F8 可能是飞行模式等媒体功能。大小写锁定灯不代表正在录音。
# OC2_VOICE_PTT_KEY=caps_lock
# LLM 请求超时秒数；方舟 plan 端点实测 2–3.2s，默认 10
OC2_LLM_TIMEOUT=10
# 逐行 JSON 对话日志（transcript / LLM 原文 / 命令 / ack / 播报 / 错误）；不设则不落盘
# 文件名建议 voice*.jsonl（已 gitignore），例如：
# OC2_VOICE_LOG=voice.jsonl
